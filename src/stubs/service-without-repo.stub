<?php

namespace {{ namespace }};

use {{ modelNamespace }};
use {{ serviceInterfaceNamespace }};
use Illuminate\Support\Collection;

class {{ class }} implements {{ interface }}
{
    protected {{ model }} $model;

    public function __construct()
    {
        $this->model = new {{ model }}();
    }

    public function getAll(array $where = [], array $columns = ['*']): Collection
    {
        return $this->model->select($columns)->where($where)->get();
    }

    public function find(array $where, array $columns = ['*']): ?object
    {
        return $this->model->select($columns)->where($where)->first();
    }

    public function create(array $data): object
    {
        return $this->model->create($data);
    }

    public function update(array $where, array $data): bool
    {
        return $this->model->where($where)->update($data);
    }

    public function delete(array $where): bool
    {
        return $this->model->where($where)->delete();
    }

    public function count(array $where = []): int
    {
        return $this->model->where($where)->count();
    }

    public function paginate(array $where, int $skip, int $limit, string $orderBy = 'id', string $order = 'desc', array $columns = ['*']): Collection
    {
        return $this->model->where($where)->select($columns)->skip($skip)->limit($limit)->orderBy($orderBy, $order)->get();
    }
}
