<?php

namespace {{ namespace }};

use {{ repositoryInterfaceNamespace }};
use {{ serviceInterfaceNamespace }};
use Illuminate\Support\Collection;

class {{ class }} implements {{ interface }}
{
    protected $repository;

    public function __construct({{ repositoryInterface }} $repository)
    {
        $this->repository = $repository;
    }

    public function getAll(array $where = [], array $columns = ['*']): Collection
    {
        return $this->repository->getAllDataByWhereCondition($where, $columns);
    }

    public function find(array $where, array $columns = ['*']): ?object
    {
        return $this->repository->getSingleDataByWhereCondition($where, $columns);
    }

    public function create(array $data): object
    {
        return $this->repository->create($data);
    }

    public function update(array $where, array $data): bool
    {
        return $this->repository->updateByWhereCondition($where, $data);
    }

    public function delete(array $where): bool
    {
        return $this->repository->deleteByQuery($where);
    }

    public function count(array $where = []): int
    {
        return $this->repository->getCountByWhereCondition($where);
    }

    public function paginate(array $where, int $skip, int $limit, string $orderBy = 'id', string $order = 'desc', array $columns = ['*']): Collection
    {
        return $this->repository->getDataByPagination($where, $skip, $limit, $orderBy, $order, $columns);
    }
}
