{
  "name": "mehedi250/laravel-structure-kit",
  "description": "Clean architecture and file structure generator for Laravel projects",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "structure",
    "clean-architecture",
    "generator",
    "scaffold"
  ],
  "authors": [
    {
      "name": "Md. Mehedi Hasan Shawon",
      "email": "mhshawon250@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "StructureKit\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "StructureKit\\StructureKitServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}