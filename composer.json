{
    "name": "mehedi250/laravel-structure-kit",
    "description": "A powerful UI + CLI scaffolding tool for Laravel — instantly generate Models, Controllers, Migrations, and Service & Repository pattern boilerplate with customizable file paths.",
    "version": "v0.1.5",
    "type": "library",
    "license": "MIT",
    "readme": "README.md",

    "keywords": [
        "laravel",
        "laravel-package",
        "laravel-tool",
        "laravel-structure",
        "laravel-architecture",
        "laravel-scaffold",
        "clean-architecture",
        "scaffold",
        "scaffolding",
        "generator",
        "code-generator",
        "file-generator",
        "artisan",
        "service-pattern",
        "repository-pattern",
        "interface-pattern",
        "design-patterns",
        "boilerplate",
        "project-structure",
        "folder-structure",
        "best-practices",
        "developer-tools",
        "backend",
        "php"
    ],

    "authors": [
        {
            "name": "Md. Mehedi Hasan Shawon",
            "email": "mhshawon250@gmail.com",
            "role": "Developer",
            "homepage": "https://github.com/mehedi250"
        }
    ],

    "homepage": "https://github.com/mehedi250/laravel-structure-kit",

    "support": {
        "issues": "https://github.com/mehedi250/laravel-structure-kit/issues",
        "source": "https://github.com/mehedi250/laravel-structure-kit",
        "docs": "https://github.com/mehedi250/laravel-structure-kit#readme"
    },

    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "symfony/console": "^6.0|^7.0|^8.0"
    },

    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "laravel/pint": "^1.0"
    },

    "autoload": {
        "psr-4": {
            "StructureKit\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "StructureKit\\Tests\\": "tests/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "StructureKit\\StructureKitServiceProvider"
            ]
        }
    },

    "config": {
        "sort-packages": true
    },

    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-html coverage",
        "format": "pint",
        "lint": "pint --test"
    },

    "scripts-descriptions": {
        "test": "Run the test suite",
        "test-coverage": "Run tests and generate HTML coverage report",
        "format": "Format code using Laravel Pint",
        "lint": "Check code style without making changes"
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}