{
  "name": "mehedi250/laravel-structure-kit",
  "description": "A clean architecture and scalable file structure generator for Laravel projects (UI + CLI)",
  "type": "library",
  "license": "MIT",
  "readme": "README.md",
  "keywords": [
    "laravel",
    "laravel-package",
    "laravel-tool",
    "laravel-structure",
    "laravel-architecture",
    "clean-architecture",
    "ddd",
    "domain-driven-design",
    "mvc",
    "scaffold",
    "scaffolding",
    "generator",
    "code-generator",
    "boilerplate",
    "project-structure",
    "folder-structure",
    "best-practices",
    "developer-tools",
    "cli",
    "artisan",
    "productivity",
    "backend",
    "php"
  ],
  "authors": [
    {
      "name": "Md. Mehedi Hasan Shawon",
      "email": "mhshawon250@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "StructureKit\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "StructureKit\\StructureKitServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}